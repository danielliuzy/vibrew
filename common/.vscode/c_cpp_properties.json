{
    "configurations": [
        {
            // common/ is compiled by BOTH builds. IntelliSense here uses the
            // Mac/clang config because it is the faster tier to iterate in;
            // anything that only compiles under one of the two toolchains
            // does not belong in this directory.
            "name": "Mac",
            "compilerPath": "/usr/bin/clang++",
            "compilerArgs": [
                "-std=c++20"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64",
            "includePath": [
                "${workspaceFolder}/**"
            ]
        }
    ],
    "version": 4
}
