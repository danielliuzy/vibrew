{
    "configurations": [
        {
            "name": "Mac",
            "compilerPath": "/usr/bin/clang++",
            "compilerArgs": [
                "-std=c++20"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64",
            "includePath": [
                "${workspaceFolder}/src/**",
                "/opt/homebrew/opt/cpp-httplib/include",
                "/opt/homebrew/opt/nlohmann-json/include",
                "/opt/homebrew/opt/openssl@3/include"
            ],
            "defines": [
                "CPPHTTPLIB_OPENSSL_SUPPORT"
            ]
        }
    ],
    "version": 4
}
